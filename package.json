{
  "name": "storage-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "docker:config": "docker compose --env-file .env.deploy -f compose.independent.yaml config --quiet",
    "docker:build": "docker compose --env-file .env.deploy -f compose.independent.yaml build",
    "docker:up": "docker compose --env-file .env.deploy -f compose.independent.yaml up -d --build",
    "docker:logs": "docker compose --env-file .env.deploy -f compose.independent.yaml logs --tail=100 -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "object-inspect": "1.13.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  }
}
